{
  "compilerOptions": {
    /* Visit https://aka.ms/tsconfig to read more about this file */

    /* Projects */
    // No changes needed here

    /* Language and Environment */
    "target": "ES2015", // Keep as is
    "lib": ["DOM", "DOM.Iterable", "ES2015"], // Add DOM libraries for React
    "jsx": "react-jsx", // Enable React JSX syntax
    "module": "commonjs", // Keep as is
    "esModuleInterop": true, // Keep as is
    "forceConsistentCasingInFileNames": true, // Keep as is

    /* Type Checking */
    "strict": true, // Keep as is
    "skipLibCheck": true, // Keep as is

    /* Modules */
    "moduleResolution": "node", // Ensure Node module resolution
    "resolveJsonModule": true, // Enable importing JSON files

    /* Additional Options */
    "allowSyntheticDefaultImports": true, // Allow default imports for React
    "isolatedModules": true // Required for React with TypeScript
  },
  "include": ["."], // Include your source folder
  "exclude": ["node_modules"] // Exclude node_modules
}
